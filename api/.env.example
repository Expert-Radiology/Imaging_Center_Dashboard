# Local development. In Azure these arrive as Container Apps environment
# variables and secrets; nothing here is baked into the image.

# Either a Key Vault secret URI (preferred, read via managed identity)...
# CLICKUP_TOKEN_SECRET_URI=https://kv-imgcenterdash-xxxx.vault.azure.net/secrets/clickup-token
# ...or the raw token, for local runs only.
CLICKUP_TOKEN=pk_...

CLICKUP_LIST_ID=901316440634

DASHBOARD_STORAGE_ACCOUNT=stimgcenterdashxxxxxx
DASHBOARD_BLOB_CONTAINER=dashboard
DASHBOARD_SNAPSHOT_TABLE=weeklysnapshots

# Where the web server reads the built frontend from.
STATIC_ROOT=../dist
PORT=8080
